#!/usr/bin/env bash

#
#  export-untold-tiles
#  UntoldEngine
#
#  User-facing wrapper for partitioning a USD/USDZ scene into streaming tiles
#  and exporting .untold tile payloads plus a manifest through Blender.
#
#
# Copyright (C) Untold Engine Studios
#
# This Source Code Form is subject to the terms of the Mozilla Public
# License, v. 2.0. If a copy of the MPL was not distributed with this
# file, You can obtain one at https://mozilla.org/MPL/2.0/.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_SCRIPT="${SCRIPT_DIR}/tilestreamingpartition.py"

usage() {
  cat <<'EOF'
Usage:
  scripts/export-untold-tiles [--blender /path/to/Blender] --input /path/scene.usdz --output-dir /path/tile_exports [tile exporter flags]

Wrapper-only options:
  --blender <path>   Override the Blender binary used to run the tile exporter
  --help             Show this help

All remaining arguments are passed through to tilestreamingpartition.py.
EOF
}

blender_bin=""
forwarded=()

while (($#)); do
  case "$1" in
    --help|-h)
      usage
      exit 0
      ;;
    --blender)
      if (($# < 2)); then
        echo "error: --blender requires a path" >&2
        exit 1
      fi
      blender_bin="$2"
      shift 2
      ;;
    *)
      forwarded+=("$1")
      shift
      ;;
  esac
done

if [[ -z "${blender_bin}" ]]; then
  if [[ -n "${BLENDER_BIN:-}" ]]; then
    blender_bin="${BLENDER_BIN}"
  elif [[ -x "/Applications/Blender.app/Contents/MacOS/Blender" ]]; then
    blender_bin="/Applications/Blender.app/Contents/MacOS/Blender"
  elif command -v blender >/dev/null 2>&1; then
    blender_bin="$(command -v blender)"
  fi
fi

if [[ -z "${blender_bin}" || ! -x "${blender_bin}" ]]; then
  cat >&2 <<'EOF'
Blender was not found.
Install Blender or provide one of:
  --blender /path/to/Blender
  BLENDER_BIN=/path/to/Blender
EOF
  exit 1
fi

echo "Using Blender: ${blender_bin}"

exec "${blender_bin}" \
  --background \
  --factory-startup \
  --python "${PYTHON_SCRIPT}" \
  -- \
  "${forwarded[@]}"
